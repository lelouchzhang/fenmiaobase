{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "bundler (Next.js / Vite / 打包器运行时)",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "allowImportingTsExtensions": false,
    "allowArbitraryExtensions": true
  }
}